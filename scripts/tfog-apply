#!/usr/bin/env python3
"""tfog-apply — apply a merged PR's reviewed plan, and post the outcome to the PR.

    scripts/tfog-apply 412
    scripts/tfog-apply 412 --workspace prod-networking --dry-run

The local, single-machine version of the apply service in docs/DESIGN.md. Its whole job is to
re-derive, from GitHub and from the stored plan, the authorization to apply — and then to apply
*that exact plan file*, never a fresh one.

Nothing about the invocation is trusted. `--workspace` selects among already-authorized
workspaces; it cannot create an authorization. The checks below run in this order for a reason:
each is cheap relative to the next, and each closes one specific way an unreviewed change could
reach real infrastructure.

  1. The PR is merged, and has a merge commit.                          DESIGN 6.1
  2. Config from the TRUSTED REF at its current tip binds this
     workspace to the PR's base branch, and has apply enabled.          DESIGN 3.1.1, 6.1
  3. A complete stored plan exists for (workspace, *, head_sha), its
     meta digest verifies, and the tfplan bytes hash to plan_sha256.    DESIGN 5.2, 5.3
  4. tree(merge_commit) == meta.planned_tree_sha — the applied content
     is the reviewed content, under squash, rebase or merge commit.     DESIGN 6.2
  5. The checked-out tree on disk matches it too, then terraform's own
     version and provider lock match the plan's.
  6. A human confirms.                                                 DESIGN 6.4 (local stand-in)

What is gone: the IAM boundary between planner and applier, the KMS signature, the GitHub
Environment approval gate (replaced by a typed confirmation), the workspace lease (Terraform's
state lock is the real backstop), and /reconcile. See docs/LOCAL.md.

Exit status: 0 applied, 1 error or verification failure, 5 nothing to apply.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from tfog import cfg, ghub, render, store, terra  # noqa: E402

EXIT_OK, EXIT_ERROR, EXIT_NOTHING = 0, 1, 5


class VerifyError(Exception):
    """A verification step said no.

    Every one of these is terminal. None is ever resolved by generating a fresh plan and
    applying that instead — the point of the whole design is that the plan being applied is the
    plan somebody read.
    """


def log(msg: str = "") -> None:
    print(msg, file=sys.stderr, flush=True)


def parse_args(argv=None):
    p = argparse.ArgumentParser(prog="tfog-apply", description="Apply a merged PR's reviewed plan.")
    p.add_argument("pr", type=int, help="pull request number (must be merged)")
    p.add_argument("--repo", help="owner/repo (default: the repo in the current directory)")
    p.add_argument("--trusted-ref", help=f"ref to read {cfg.FILENAME} from (default: the repo's default branch)")
    p.add_argument("--workspace", action="append", default=[], help="limit to this workspace (repeatable)")
    p.add_argument("--store", help=f"plan store root (default: $TFOG_STORE or {store.DEFAULT_ROOT})")
    p.add_argument("--no-comment", action="store_true", help="do not post the outcome to the PR")
    p.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    p.add_argument("--dry-run", action="store_true", help="verify and init, then stop before applying")
    p.add_argument("--force", action="store_true", help="re-apply a plan already recorded as applied")
    p.add_argument("--no-impersonate", action="store_true", help="ignore impersonate.apply; use ambient credentials")
    return p.parse_args(argv)


def main(argv=None) -> int:
    args = parse_args(argv)
    ghub.require_gh()
    terra.require_tools("git")

    owner, repo = _resolve_repo(args.repo)
    st = store.Store(args.store)

    # -- 1. the PR is merged ----------------------------------------------
    pr = ghub.pull_request(owner, repo, args.pr)
    if not pr.get("merged"):
        state = "open" if pr.get("state") == "open" else "closed without merging"
        raise VerifyError(f"PR #{args.pr} is {state}; there is nothing to apply")
    merge_commit = pr.get("merge_commit_sha")
    if not merge_commit:
        raise VerifyError(f"PR #{args.pr} is merged but reports no merge commit")
    base_ref = pr["base"]["ref"]
    head_sha = pr["head"]["sha"]
    log(f"PR #{args.pr}: merged into {base_ref} as {merge_commit[:12]} · head {head_sha[:12]}")

    # -- 2. config from the trusted ref, at its CURRENT tip ---------------
    #
    # Current tip, not meta.config_ref_sha. Config is fail-closed on change: a workspace
    # deauthorized, or repointed at a narrower identity, between plan and merge must not apply.
    # meta.config_ref_sha is kept for the audit trail and is never used to authorize.
    trusted_ref = args.trusted_ref or os.environ.get("TFOG_TRUSTED_REF") or ghub.default_branch(owner, repo)
    text, config_ref_sha = ghub.file_at_ref(owner, repo, cfg.FILENAME, trusted_ref)
    config = cfg.load(text)
    log(f"config: {cfg.FILENAME} @ {trusted_ref} ({config_ref_sha[:12]})")

    bound = [w for w in config.workspaces if cfg.match_branch(w.branch, base_ref)]
    if args.workspace:
        wanted = set(args.workspace)
        off_branch = wanted - {w.name for w in bound}
        if off_branch:
            raise VerifyError(
                f"{', '.join(sorted(off_branch))} is not bound to base branch {base_ref!r} on "
                f"{trusted_ref}; --workspace selects among authorized workspaces, it cannot "
                "authorize one"
            )
        bound = [w for w in bound if w.name in wanted]

    # -- 3. which of them actually have a reviewed plan for this head? ----
    work = []
    for ws in bound:
        keys = st.find(owner, repo, ws.name, head_sha=head_sha)
        if not keys:
            continue
        if len(keys) > 1:
            raise VerifyError(
                f"{len(keys)} stored plans for head {head_sha[:12]} "
                f"({', '.join(k.base_sha[:8] for k in keys)}); the store is ambiguous, "
                "remove the ones that were not reviewed"
            )
        work.append((ws, keys[0]))

    if not work:
        names = ", ".join(w.name for w in bound) or "none"
        log(f"no stored plan for head {head_sha[:12]} in any workspace bound to {base_ref!r} ({names}).")
        log("A merged PR with no plan is never applied and never silently skipped — this is the")
        log("message. Run tfog-plan against the pre-merge head, or apply by hand and say so.")
        return EXIT_NOTHING

    log(f"to apply: {', '.join(ws.name for ws, _ in work)}")

    source_repo = terra.local_repo_root()
    merge_tree_sha = ghub.tree_sha(owner, repo, merge_commit)

    failures = []
    applied = skipped = 0
    for ws, key in work:
        try:
            did = apply_one(
                args, st, ws, key,
                owner=owner, repo=repo, pr_number=args.pr, base_ref=base_ref,
                merge_commit=merge_commit, merge_tree_sha=merge_tree_sha,
                trusted_ref=trusted_ref, source_repo=source_repo,
            )
            applied += bool(did)
            skipped += not did
        except (VerifyError, terra.TFError, store.StoreError) as e:
            failures.append((ws.name, e))
            log(f"\n{ws.name}: {e}")

    log("")
    log(f"of {len(work)} workspace(s): applied {applied}, skipped {skipped}, failed {len(failures)}")
    for name, e in failures:
        log(f"  {name}: {str(e).splitlines()[0]}")
    return EXIT_ERROR if failures else EXIT_OK


def apply_one(args, st, ws, key, *, owner, repo, pr_number, base_ref, merge_commit,
              merge_tree_sha, trusted_ref, source_repo) -> bool:
    log(f"\n=== {ws.name} · {ws.dir} · key {key.prefix()}")

    if not ws.apply.enabled:
        raise VerifyError("apply is disabled for this workspace (plan-only)")

    # `require_protected_base` asserts what DESIGN 3.1's original justification only assumed:
    # that the base branch really does require review. An unanswerable question here is a
    # refusal, not a pass — a token that cannot read protection cannot confirm the premise.
    if ws.apply.require_protected_base:
        protected = ghub.branch_requires_reviews(owner, repo, base_ref)
        if protected is None:
            raise VerifyError(
                f"require_protected_base is set but branch protection on {base_ref!r} "
                "could not be read (the token likely lacks admin read). Refusing to apply."
            )
        if not protected:
            raise VerifyError(
                f"require_protected_base is set but {base_ref!r} does not require "
                "pull request reviews"
            )
        log(f"base branch {base_ref!r}: required reviews confirmed")

    prior = st.read_state(key)
    if prior.get("state") == store.STATE_APPLIED and not args.force:
        log(f"already applied at {prior.get('updated_at')}; nothing to do (pass --force to re-apply)")
        return False
    if prior.get("state") == store.STATE_APPLY_FAILED and not args.force:
        raise VerifyError(
            f"a previous apply of this plan failed at {prior.get('updated_at')} and may "
            f"have changed infrastructure part-way. Read {st.key_dir(key)}/apply-*.log, then "
            "re-plan — or pass --force if you have and you mean it."
        )

    # -- the stored plan ---------------------------------------------------
    meta = st.read_meta(key)  # verifies the meta digest, or raises
    for field, expected in (("owner", key.owner), ("repo", key.repo), ("workspace", key.workspace),
                            ("base_sha", key.base_sha), ("head_sha", key.head_sha)):
        if meta.get(field) != expected:
            raise VerifyError(f"meta.{field} is {meta.get(field)!r}, expected {expected!r}")
    if meta.get("pr") != pr_number:
        raise VerifyError(f"this plan was made for PR #{meta.get('pr')}, not #{pr_number}")
    if meta.get("workspace_dir") != ws.dir:
        raise VerifyError(
            f"planned {meta.get('workspace_dir')!r}, config now says {ws.dir!r}; "
            "the workspace moved between plan and merge"
        )

    plan_path = st.path(key, store.ARTIFACT_PLAN)
    actual = store.sha256_file(plan_path)
    if actual != meta["plan_sha256"]:
        raise VerifyError(
            f"{plan_path} hashes to {actual[:12]}, meta records {meta['plan_sha256'][:12]} "
            "— the plan artifact changed after it was stored. Never work around this by re-planning."
        )
    log(f"plan artifact verified: {actual[:12]}")

    # Cross-check against what was actually published to the PR. The comment is an index, not
    # an authority: it cannot make this apply do something else, only make it refuse.
    _cross_check_comment(owner, repo, pr_number, ws, meta)

    if not meta.get("has_changes"):
        log("the reviewed plan proposes no changes; nothing to apply")
        st.write_state(key, store.STATE_APPLIED, note="no changes to apply", merge_commit_sha=merge_commit)
        return False

    # -- 4. the tree test -------------------------------------------------
    #
    # The one check that subsumes several others. Equal trees mean the content about to be
    # applied is byte-identical to the content that was planned and reviewed — which also
    # proves the base did not move, since a moved base yields a different tree. And it holds
    # under squash and rebase, where the merge commit SHA cannot match by construction.
    if merge_tree_sha != meta["planned_tree_sha"]:
        raise VerifyError(
            f"merge commit {merge_commit[:12]} has tree {merge_tree_sha[:12]}, the plan "
            f"was built on tree {meta['planned_tree_sha'][:12]}. The merged content is not the "
            "reviewed content — most likely the base branch moved after the plan. Re-plan."
        )
    log(f"tree {merge_tree_sha[:12]} matches the planned tree")

    binary = terra.terraform_bin()
    local_version = terra.terraform_version(binary)
    if local_version != meta["terraform_version"]:
        raise VerifyError(
            f"this plan was built with terraform {meta['terraform_version']}, the local "
            f"binary is {local_version}. A saved plan is version-specific; point "
            "$TFOG_TERRAFORM_BIN at the right one."
        )

    impersonate = "" if args.no_impersonate else ws.impersonate.apply
    log(f"identity: {impersonate or 'ambient credentials (no impersonation)'}")

    with terra.checkout(
        merge_commit, ghub.clone_url(owner, repo), source_repo, fetch_refs=(base_ref,)
    ) as co:
        # 5. Verify already compared trees via the API; this checks what actually landed on
        # disk, which is the thing Terraform is about to read.
        if co.tree_sha != meta["planned_tree_sha"]:
            raise VerifyError(
                f"checked-out tree is {co.tree_sha[:12]}, expected "
                f"{meta['planned_tree_sha'][:12]}"
            )
        workdir = co.root / ws.dir
        if not workdir.is_dir():
            raise VerifyError(f"{ws.dir} does not exist at {merge_commit[:12]}")

        runner = terra.Runner(workdir=workdir, binary=binary, impersonate=impersonate)
        runner.init(ws.backend, ws.terraform_workspace)

        lock_digest = terra.provider_lock_digest(workdir)
        if lock_digest != meta["provider_lock_sha256"]:
            raise VerifyError(
                f"provider lock digest is {lock_digest[:12] or '(none)'}, the plan was "
                f"built against {meta['provider_lock_sha256'][:12] or '(none)'}. Different provider "
                "code applying a plan built against other provider code is not the reviewed change."
            )
        log(f"provider lock verified: {lock_digest[:12] or '(no lock file)'}")

        tally = meta["resource_change_counts"]
        if not _confirm(args, ws, key, meta, tally, st):
            log("not confirmed; nothing applied")
            return False

        if args.dry_run:
            log("--dry-run: verified and initialised; stopping before apply")
            return False

        staged = workdir / "tfog.tfplan"
        staged.write_bytes(plan_path.read_bytes())

        log_path, attempt = st.apply_log_path(key)
        st.write_state(key, store.STATE_APPLYING, attempt=attempt, merge_commit_sha=merge_commit)
        meta_for_comment = {**meta, "merge_commit_sha": merge_commit}
        try:
            with open(log_path, "w") as lf:
                runner.log = lf
                output = runner.apply(staged, timeout=ws.apply_timeout)
        except (terra.StalePlan, terra.TFError) as e:
            st.write_state(key, store.STATE_APPLY_FAILED, attempt=attempt,
                           merge_commit_sha=merge_commit, error=str(e).splitlines()[0])
            if not args.no_comment:
                ghub.add_comment(owner, repo, pr_number, render.apply_body(
                    workspace=ws, meta=meta_for_comment, tally=tally, ok=False,
                    detail=str(e)[:4000], log_path=log_path, marker=ghub.marker("apply", ws.name),
                ))
            raise

        st.write_state(key, store.STATE_APPLIED, attempt=attempt, merge_commit_sha=merge_commit)

    log(f"{ws.name}: applied · log {log_path}")
    if not args.no_comment:
        c = ghub.add_comment(owner, repo, pr_number, render.apply_body(
            workspace=ws, meta=meta_for_comment, tally=tally, ok=True,
            detail=_apply_tail(output), log_path=log_path, marker=ghub.marker("apply", ws.name),
        ))
        log(f"posted: {c.get('html_url')}")
    return True


def _cross_check_comment(owner, repo, pr_number, ws, meta) -> None:
    comment = ghub.find_comment(owner, repo, pr_number, ghub.marker("plan", ws.name))
    if comment is None:
        log("warning: no plan comment on the PR for this workspace — nothing was published for review")
        return
    published = render.parse_meta_block(comment.get("body") or "")
    if published is None:
        log("warning: the plan comment carries no machine-readable meta block; skipping cross-check")
        return
    for field in ("plan_sha256", "planned_tree_sha", "base_sha", "head_sha", "digest"):
        if published.get(field) != meta.get(field):
            raise VerifyError(
                f"the plan published to the PR records {field}="
                f"{str(published.get(field))[:12]}, the stored plan has "
                f"{str(meta.get(field))[:12]}. The plan on disk is not the plan that was "
                "reviewed."
            )
    log(f"cross-checked against the plan comment ({comment.get('html_url')})")


def _confirm(args, ws, key, meta, tally, st) -> bool:
    """The local stand-in for the GitHub Environment approval gate (DESIGN 6.4).

    A typed workspace name rather than y/N, because this is the last gate before real
    infrastructure changes and the whole value of a gate is that it cannot be cleared by reflex.
    """
    lines, omitted = render.address_lines(st.path(key, store.ARTIFACT_PLAN_JSON).read_bytes(), limit=50)
    log("")
    log(f"  {ws.name} · {ws.dir} · environment {ws.apply.environment}")
    log(f"  {render.headline(tally)}")
    log(f"  state: gs://{ws.backend.bucket}/{ws.backend.prefix}")
    log(f"  identity: {ws.impersonate.apply or 'ambient credentials'}")
    log("")
    for line in lines:
        log(f"  {line}")
    if omitted:
        log(f"  … and {omitted} more (full list in {st.path(key, store.ARTIFACT_PLAN_TEXT)})")
    log("")
    if args.yes or args.dry_run:
        if args.yes:
            log("--yes: confirmation skipped")
        return True
    if not sys.stdin.isatty():
        raise VerifyError(
            "stdin is not a terminal and --yes was not given; refusing to apply unconfirmed"
        )
    try:
        answer = input(f"Type the workspace name ({ws.name}) to apply, anything else to skip: ")
    except EOFError:
        return False
    return answer.strip() == ws.name


def _apply_tail(output: str, lines: int = 12) -> str:
    parts = [ln for ln in output.strip().splitlines() if ln.strip()]
    return "\n".join(parts[-lines:])


def _resolve_repo(flag):
    if flag:
        if "/" not in flag:
            raise SystemExit("--repo must be owner/repo")
        owner, _, repo = flag.partition("/")
        return owner, repo
    try:
        return ghub.repo_from_cwd()
    except ghub.GHError as e:
        raise SystemExit(f"could not determine the repository; pass --repo owner/repo\n{e}") from e


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        log("\ninterrupted")
        sys.exit(130)
    except (VerifyError, cfg.ConfigError, ghub.GHError, store.StoreError, terra.TFError) as err:
        log(f"error: {err}")
        sys.exit(EXIT_ERROR)
